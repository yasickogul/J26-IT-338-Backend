APP_ENV=development
# Neon POOLED string, driver asyncpg. Use ssl=require (NOT sslmode) and remove channel_binding=...
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST-pooler.neon.tech/DB?ssl=require
# Neon DIRECT (non-pooled) string for Alembic
DATABASE_URL_DIRECT=postgresql+asyncpg://USER:PASS@HOST.neon.tech/DB?ssl=require
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# Required only for flows that intentionally invoke the existing Gemini adapter.
GEMINI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# C3 stores independent 768-dimensional LaBSE embeddings in c3.legal_chunks
C3_EMBEDDING_MODEL=sentence-transformers/LaBSE
C3_EMBEDDING_DIM=768
FILE_STORAGE=local
FILE_STORAGE_PATH=./data/uploads

# C3 image OCR (JPEG/PNG; Tesseract executable and language packs are external)
C3_OCR_MAX_IMAGE_BYTES=10485760
C3_OCR_MAX_DECODED_PIXELS=40000000
C3_OCR_MAX_PROCESSED_PIXELS=40000000
C3_OCR_IMAGE_SCALE=1
C3_OCR_PSM=6
C3_OCR_LANGUAGES=eng,sin,tam
C3_OCR_LOW_CONFIDENCE_THRESHOLD=0.60
C3_OCR_IMPROVE_CONTRAST=true
C3_OCR_REDUCE_NOISE=false
C3_OCR_DESKEW=false
C3_OCR_DESKEW_MAX_ANGLE_DEGREES=5.0
# Optional local FastText language-ID model; the application never downloads it.
COMPNET_FASTTEXT_MODEL_PATH=

# C3 Phase 5 NLP feature flags retain their existing opt-in defaults.
COMPNET_LANGUAGE_DETECTION_ENABLED=false
COMPNET_CLAIM_EXTRACTION_ENABLED=false
